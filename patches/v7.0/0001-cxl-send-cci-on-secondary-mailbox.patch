From: Roger C. Pao <roger.pao@smartm.com>
Date: Tue, 1 Sep 2026 17:00:00 -0700
Subject: [PATCH] cxl: send userspace CCI on the Secondary Mailbox

Apply with patches/v7.0/apply-secondary-mbox.py (preferred) or
patch -p1 --ignore-whitespace.

Lab/debug only. The CXL spec reserves the Secondary Mailbox (device
capability ID 0x3) for firmware. Upstream Linux maps and uses only the
primary mailbox. This patch maps the secondary mailbox when present and
lets CXL_MEM_SEND_COMMAND target it.

Userspace sets cxl_send_command.flags |= CXL_MEM_SEND_FLAG_SECONDARY_MBOX
(BIT(16)). Returns -ENODEV if the device has no secondary mailbox.
Kernel-internal commands (identify, events, poison, ...) stay on the
primary mailbox so the OS stack is unchanged.

Not intended for upstream: firmware may already own the secondary
doorbell.

Signed-off-by: Roger C. Pao <roger.pao@smartm.com>
---
 drivers/cxl/core/mbox.c        |  22 ++++++-
 drivers/cxl/core/memdev.c      |  21 +++++++
 drivers/cxl/core/regs.c        |  17 +++++-
 drivers/cxl/cxl.h              |   5 +-
 drivers/cxl/cxlmem.h           |  12 ++++
 drivers/cxl/pci.c              | 124 ++++++++++++++++++++++++++++------
 include/uapi/linux/cxl_mem.h   |   8 +++
 7 files changed, 190 insertions(+), 19 deletions(-)

diff --git a/drivers/cxl/cxl.h b/drivers/cxl/cxl.h
index 111111111111..222222222222 100644
--- a/drivers/cxl/cxl.h
+++ b/drivers/cxl/cxl.h
@@ -219,10 +219,11 @@ struct cxl_regs {
 	 * Common set of CXL Device register block base pointers
 	 * @status: CXL 2.0 8.2.8.3 Device Status Registers
 	 * @mbox: CXL 2.0 8.2.8.4 Mailbox Registers
+	 * @mbox2: CXL 2.0 8.2.8.4 Secondary Mailbox Registers (optional)
 	 * @memdev: CXL 2.0 8.2.8.5 Memory Device Registers
 	 */
 	struct_group_tagged(cxl_device_regs, device_regs,
-		void __iomem *status, *mbox, *memdev;
+		void __iomem *status, *mbox, *memdev, *mbox2;
 	);
 
 	struct_group_tagged(cxl_pmu_regs, pmu_regs,
@@ -261,6 +262,7 @@ struct cxl_component_reg_map {
 struct cxl_device_reg_map {
 	struct cxl_reg_map status;
 	struct cxl_reg_map mbox;
+	struct cxl_reg_map mbox2;
 	struct cxl_reg_map memdev;
 };
 
diff --git a/drivers/cxl/cxlmem.h b/drivers/cxl/cxlmem.h
index 111111111111..222222222222 100644
--- a/drivers/cxl/cxlmem.h
+++ b/drivers/cxl/cxlmem.h
@@ -11,6 +11,14 @@
 #include <linux/cper.h>
 #include <linux/node.h>
 #include "cxl.h"
+
+/*
+ * Fallback when building against stock uapi headers that lack the
+ * secondary-mailbox send flag (BIT(16) on cxl_send_command.flags).
+ */
+#ifndef CXL_MEM_SEND_FLAG_SECONDARY_MBOX
+#define CXL_MEM_SEND_FLAG_SECONDARY_MBOX BIT(16)
+#endif
 
 /* CXL 2.0 8.2.8.5.1.1 Memory Device Status Register */
 #define CXLMDEV_STATUS_OFFSET 0x0
@@ -425,6 +433,8 @@ struct cxl_dev_state {
  * @serial: PCIe Device Serial Number
  * @type: Generic Memory Class device or Vendor Specific Memory device
  * @cxl_mbox: CXL mailbox context
+ * @cxl_mbox2: Optional Secondary Mailbox context (firmware mailbox).
+ *             Only used by CXL_MEM_SEND_COMMAND with SECONDARY_MBOX.
  * @cxlfs: CXL features context
  */
 struct cxl_dev_state {
@@ -441,6 +451,7 @@ struct cxl_dev_state {
 	u64 serial;
 	enum cxl_devtype type;
 	struct cxl_mailbox cxl_mbox;
+	struct cxl_mailbox cxl_mbox2;
 #ifdef CONFIG_CXL_FEATURES
 	struct cxl_features_state *cxlfs;
 #endif
diff --git a/drivers/cxl/core/regs.c b/drivers/cxl/core/regs.c
index 111111111111..222222222222 100644
--- a/drivers/cxl/core/regs.c
+++ b/drivers/cxl/core/regs.c
@@ -154,7 +154,8 @@ void cxl_probe_device_regs(struct device *dev, void __iomem *base,
 			rmap = &map->mbox;
 			break;
 		case CXLDEV_CAP_CAP_ID_SECONDARY_MAILBOX:
-			dev_dbg(dev, "found Secondary Mailbox capability (0x%x)\n", offset);
+			dev_info(dev, "found Secondary Mailbox capability (0x%x)\n", offset);
+			rmap = &map->mbox2;
 			break;
 		case CXLDEV_CAP_CAP_ID_MEMDEV:
 			dev_dbg(dev, "found Memory Device capability (0x%x)\n", offset);
@@ -246,6 +247,7 @@ int cxl_map_device_regs(const struct cxl_register_map *map,
 	} mapinfo[] = {
 		{ &map->device_map.status, &regs->status, },
 		{ &map->device_map.mbox, &regs->mbox, },
+		{ &map->device_map.mbox2, &regs->mbox2, },
 		{ &map->device_map.memdev, &regs->memdev, },
 	};
 	int i;
@@ -259,8 +261,19 @@ int cxl_map_device_regs(const struct cxl_register_map *map,
 
 		addr = phys_addr + mi->rmap->offset;
 		length = mi->rmap->size;
 		*(mi->addr) = devm_cxl_iomap_block(host, addr, length);
-		if (!*(mi->addr))
+		if (!*(mi->addr)) {
+			/*
+			 * Secondary mailbox is optional. Do not fail the
+			 * device if firmware-owned registers cannot be mapped.
+			 */
+			if (mi->rmap == &map->device_map.mbox2) {
+				dev_warn(host,
+					 "Failed to map Secondary Mailbox\n");
+				continue;
+			}
 			return -ENOMEM;
+		}
 	}
 
 	return 0;
diff --git a/drivers/cxl/core/mbox.c b/drivers/cxl/core/mbox.c
index 111111111111..222222222222 100644
--- a/drivers/cxl/core/mbox.c
+++ b/drivers/cxl/core/mbox.c
@@ -640,10 +640,30 @@ int cxl_send_cmd(struct cxl_mailbox *cxl_mbox, struct cxl_send_command __user *s)
 	if (copy_from_user(&send, s, sizeof(send)))
 		return -EFAULT;
 
+	if (send.flags & CXL_MEM_SEND_FLAG_SECONDARY_MBOX) {
+		struct cxl_dev_state *cxlds = mbox_to_cxlds(cxl_mbox);
+
+		if (!cxlds || !cxlds->regs.mbox2 || !cxlds->cxl_mbox2.mbox_send)
+			return -ENODEV;
+
+		/*
+		 * Strip the routing flag before validation. Command-info
+		 * flags live in the low bits; this bit is send-only.
+		 */
+		send.flags &= ~CXL_MEM_SEND_FLAG_SECONDARY_MBOX;
+		cxl_mbox = &cxlds->cxl_mbox2;
+		dev_dbg(dev, "Send IOCTL -> Secondary Mailbox\n");
+	}
+
 	rc = cxl_validate_cmd_from_user(&mbox_cmd, cxl_mbox, &send);
 	if (rc)
 		return rc;
 
 	rc = handle_mailbox_cmd_from_user(cxl_mbox, &mbox_cmd, send.out.payload,
 					  &send.out.size, &send.retval);
